{
  "name": "panggung-unila",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mode Panggung debat Bakal Calon Rektor Universitas Lampung 2027–2031: 4 slide, layar penuh.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa": "node scripts/qa.mjs",
    "pdf": "node scripts/pdf.mjs",
    "pptx": "node scripts/pptx.mjs",
    "html": "vite build -c vite.mandiri.config.ts && node scripts/html-mandiri.mjs",
    "qa:mandiri": "node scripts/mandiri-qa.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "gsap": "3.15.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jszip": "3.10.1",
    "pdfjs-dist": "4.10.38",
    "playwright-core": "1.55.0",
    "pptxgenjs": "4.0.1",
    "sharp": "0.34.4",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.0.14"
  }
}
